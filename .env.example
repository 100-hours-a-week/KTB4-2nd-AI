# 프로파일. v2는 gpu
AI_PROFILE=cpu
# thresholds.yaml 항목 이름과 같음. v2 정리 실행기는 qwen3-vl-embedding-2b, 아래 EMBEDDING_* 필요
EMBED_MODEL=siglip2-so400m-naflex
EMBED_DEVICE=cpu
MODEL_PATH=./models/siglip2

# 프로세스 주소. 컨테이너 안에서는 전부 127.0.0.1
WORKER_URL=http://127.0.0.1:8002
API_URL=http://127.0.0.1:8000
QDRANT_URL=http://127.0.0.1:6333

# 백엔드와 같은 값. 서버는 Parameter Store
API_KEY=

# 이미지 소스. s3는 인스턴스 역할로 읽음, local은 IMAGE_DIR의 파일을 읽음
IMAGE_SOURCE=s3
S3_BUCKET=
AWS_REGION=ap-northeast-2
IMAGE_DIR=./data/photos

# 상한. v1은 워커 스레드가 하나라 동시 처리 1
MAX_CONCURRENT=1
MAX_QUEUE=20
WORKER_DEAD_SEC=120
TASK_TIMEOUT_SEC=1800
WATCHDOG_INTERVAL_SEC=5
CALLBACK_RETRIES=3

THRESHOLDS_PATH=app/pipeline/thresholds.yaml

# 개발용. 1이면 tests/fakes.py의 가짜 파이프라인으로 서버만 돌림
FAKE_PIPELINE=0

# 운영 기본은 INFO. 오류를 재현하는 짧은 구간에만 DEBUG로 올리고 확인 뒤 되돌림
LOG_LEVEL=INFO

# 배포 식별자. 클라우드가 이미지 SHA를 런타임 환경 변수로 주입, 미설정이면 unknown
RELEASE=

# v2 공통 VLM. /v1을 포함한 주소와 vLLM의 served model name을 입력한다.
# 비워 두면 v1 기동에는 영향이 없다. 실제 검색 연결은 별도 조립이 필요하다.
VLM_BASE_URL=
VLM_MODEL=
# BE 인증키와 별개이며 vLLM 서버에서 설정한 키를 사용한다.
VLM_API_KEY=
# 개발용 기본값. 검색 단계의 더 짧은 상한은 호출자가 적용한다.
VLM_CONNECT_TIMEOUT_SEC=5
VLM_TIMEOUT_SEC=60

# v2 임베딩 vLLM. /v1을 포함한 주소, 서빙 이름과 API 키는 docker/embedding/.env와 같은 값
# 비워 두면 v1 기동에는 영향이 없다. 정리는 EMBED_MODEL=qwen3-vl-embedding-2b일 때 사용한다.
EMBEDDING_BASE_URL=
EMBEDDING_SERVED_MODEL_NAME=
EMBEDDING_API_KEY=
EMBEDDING_CONNECT_TIMEOUT_SEC=5
EMBEDDING_TIMEOUT_SEC=30
