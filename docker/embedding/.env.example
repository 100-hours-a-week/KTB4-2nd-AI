# Kael이 검증한 이미지 태그 또는 digest와 모델 버전을 입력한다. latest는 사용하지 않는다.
# 2026-10-13 Colab L4 검증 값, vLLM 0.31.0은 RunPod 생성용 vLLM과 같은 버전
VLLM_EMBEDDING_IMAGE=vllm/vllm-openai:v0.31.0
EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-2B
EMBEDDING_MODEL_REVISION=9f2f7e710d6d81056aa5c0a4f04764fec6bb7bda
# 클라이언트가 요청 본문의 model 필드에 넣는 이름
EMBEDDING_SERVED_MODEL_NAME=qwen3-vl-embedding-2b
# BE API와 RunPod 생성용 VLM의 인증키와 구분한다.
EMBEDDING_API_KEY=
# 접근 권한이 필요한 모델을 사용할 때만 설정한다.
HF_TOKEN=
# 기본은 같은 호스트에서의 확인용이다. 서비스 연결 주소는 클라우드와 조율한다.
EMBEDDING_BIND_HOST=127.0.0.1
EMBEDDING_PORT=8003
