# 로컬 mock 연결용. 실제 배포에서는 클라우드가 주소와 인증값을 주입한다.
API_KEY=local-jobs-only
JOBS_ENV=local
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_TRIP_CREATE_REQUEST_TOPIC=local.yeodam.trip-create.request
KAFKA_TRIP_CREATE_RESULT_TOPIC=local.yeodam.trip-create.result
KAFKA_TRIP_UPDATE_REQUEST_TOPIC=local.yeodam.trip-update.request
KAFKA_TRIP_UPDATE_RESULT_TOPIC=local.yeodam.trip-update.result
KAFKA_STORY_CREATE_REQUEST_TOPIC=local.yeodam.story-create.request
KAFKA_STORY_CREATE_RESULT_TOPIC=local.yeodam.story-create.result
IMAGE_SOURCE=local
JOBS_FAKE_PIPELINE=true
SEARCH_ENABLED=false
# 실제 기능 연결 시 false로 바꾸고 async module:function을 지정한다.
JOBS_PROCESS_HANDLER=
JOBS_STORY_HANDLER=
JOBS_HEARTBEAT_SEC=5
JOBS_LEASE_SEC=120
JOBS_TIMEOUT_SEC=300
JOBS_PUBLISH_LEASE_SEC=60
JOBS_POLL_SEC=0.5
JOBS_PHOTOS_READY_TTL_SEC=604800
