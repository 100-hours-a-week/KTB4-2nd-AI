{
  "title": "여담 AI v2",
  "uid": "yeodam-ai-v2",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "constant",
        "query": "staging",
        "current": {
          "text": "staging",
          "value": "staging"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "기능별 p95 지연 시간",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(yeodam:operation_duration_seconds_bucket:max{environment=\"$environment\",phase=~\"total|request\"}[5m])))",
          "legendFormat": "{{operation}} {{outcome}} {{state}} {{feature}} {{metric}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "기능별 처리량과 결과",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation, outcome) (rate(yeodam:operation_duration_seconds_count:max{environment=\"$environment\",phase=~\"total|request\"}[5m]))",
          "legendFormat": "{{operation}} {{outcome}} {{state}} {{feature}} {{metric}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "작업 대기와 결과 발행 대기",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "yeodam:jobs:max{environment=\"$environment\"}",
          "legendFormat": "{{operation}} {{outcome}} {{state}} {{feature}} {{metric}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "최근 정답 기반 품질 평가",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "yeodam:evaluation:max{environment=\"$environment\",metric!~\"samples|timestamp\"}",
          "legendFormat": "{{feature}} {{metric}} / {{dataset}} / {{model}} / k={{k}} / {{unclassified_policy}} / {{source}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "평가 표본 수",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "yeodam:evaluation:max{environment=\"$environment\",metric=\"samples\"}",
          "legendFormat": "{{feature}} {{metric}} / {{dataset}} / {{model}} / k={{k}} / {{unclassified_policy}} / {{source}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "평가 이후 경과 시간",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - yeodam:evaluation:max{environment=\"$environment\",metric=\"timestamp\"}",
          "legendFormat": "{{feature}} {{metric}} / {{dataset}} / {{model}} / k={{k}} / {{unclassified_policy}} / {{source}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "세부 단계별 p95 지연 시간",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, operation, phase) (rate(yeodam:operation_duration_seconds_bucket:max{environment=\"$environment\",phase!~\"total|queue|execution|request\"}[15m])))",
          "legendFormat": "{{operation}} {{phase}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "세부 단계별 오류와 취소",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation, phase, outcome) (rate(yeodam:operation_duration_seconds_count:max{environment=\"$environment\",phase!~\"total|queue|execution|request\",outcome=~\"error|cancelled\"}[15m]))",
          "legendFormat": "{{operation}} {{phase}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "GPU 사용률",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg by (server) (DCGM_FI_DEV_GPU_UTIL{environment=\"$environment\"}) / 100",
          "legendFormat": "{{server}} dcgm"
        },
        {
          "refId": "B",
          "expr": "avg by (server) (nvidia_smi_utilization_gpu_ratio{environment=\"$environment\"})",
          "legendFormat": "{{server}} nvidia-smi"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "title": "GPU 메모리 사용량",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (server) (DCGM_FI_DEV_FB_USED{environment=\"$environment\"}) * 1024 * 1024",
          "legendFormat": "{{server}} dcgm"
        },
        {
          "refId": "B",
          "expr": "sum by (server) (nvidia_smi_memory_used_bytes{environment=\"$environment\"})",
          "legendFormat": "{{server}} nvidia-smi"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "title": "vLLM 대기와 실행 요청",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (server) (vllm:num_requests_waiting{environment=\"$environment\"})",
          "legendFormat": "{{server}} 대기"
        },
        {
          "refId": "B",
          "expr": "sum by (server) (vllm:num_requests_running{environment=\"$environment\"})",
          "legendFormat": "{{server}} 실행"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "vLLM KV 캐시 사용률과 생성 토큰 처리량",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (server) (vllm:kv_cache_usage_perc{environment=\"$environment\"})",
          "legendFormat": "{{server}} KV 캐시"
        },
        {
          "refId": "B",
          "expr": "sum by (server) (rate(vllm:generation_tokens_total{environment=\"$environment\"}[5m]))",
          "legendFormat": "{{server}} 생성 토큰/초"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "title": "AI 프로세스 메모리",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes{job=\"yeodam-ai\",environment=\"$environment\"}",
          "legendFormat": "API {{instance}}"
        },
        {
          "refId": "B",
          "expr": "max by (operation) (yeodam_ai_job_peak_memory_bytes{environment=\"$environment\"})",
          "legendFormat": "최근 {{operation}} 작업 최대"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    }
  ]
}
