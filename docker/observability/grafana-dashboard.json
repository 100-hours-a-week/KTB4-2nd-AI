{
  "title": "여담 AI v2",
  "uid": "yeodam-ai-v2",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "environment",
        "type": "constant",
        "query": "staging",
        "current": {
          "text": "staging",
          "value": "staging"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "기능별 p95 지연 시간",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(yeodam:operation_duration_seconds_bucket:max{environment=\"$environment\",phase=~\"total|request\"}[5m])))",
          "legendFormat": "{{operation}} {{outcome}} {{state}} {{feature}} {{metric}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "기능별 처리량과 결과",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation, outcome) (rate(yeodam:operation_duration_seconds_count:max{environment=\"$environment\",phase=~\"total|request\"}[5m]))",
          "legendFormat": "{{operation}} {{outcome}} {{state}} {{feature}} {{metric}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "작업 대기와 결과 발행 대기",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "yeodam:jobs:max{environment=\"$environment\"}",
          "legendFormat": "{{operation}} {{outcome}} {{state}} {{feature}} {{metric}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "최근 정답 기반 품질 평가",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "yeodam:evaluation:max{environment=\"$environment\",metric!~\"samples|timestamp\"}",
          "legendFormat": "{{feature}} {{metric}} / {{dataset}} / {{model}} / k={{k}} / {{unclassified_policy}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "평가 표본 수",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "yeodam:evaluation:max{environment=\"$environment\",metric=\"samples\"}",
          "legendFormat": "{{feature}} {{metric}} / {{dataset}} / {{model}} / k={{k}} / {{unclassified_policy}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "평가 이후 경과 시간",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - yeodam:evaluation:max{environment=\"$environment\",metric=\"timestamp\"}",
          "legendFormat": "{{feature}} {{metric}} / {{dataset}} / {{model}} / k={{k}} / {{unclassified_policy}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "세부 단계별 p95 지연 시간",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, operation, phase) (rate(yeodam:operation_duration_seconds_bucket:max{environment=\"$environment\",phase!~\"total|queue|execution|request\"}[15m])))",
          "legendFormat": "{{operation}} {{phase}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "세부 단계별 오류와 취소",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation, phase, outcome) (rate(yeodam:operation_duration_seconds_count:max{environment=\"$environment\",phase!~\"total|queue|execution|request\",outcome=~\"error|cancelled\"}[15m]))",
          "legendFormat": "{{operation}} {{phase}} {{outcome}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    }
  ]
}
