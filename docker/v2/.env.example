# 통합 검증용. 실제 주소와 인증값은 저장소 밖에서 전달한다.
API_KEY=
JOBS_ENV=staging
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
KAFKA_TRIP_CREATE_REQUEST_TOPIC=staging.yeodam.trip-create.request
KAFKA_TRIP_CREATE_RESULT_TOPIC=staging.yeodam.trip-create.result
KAFKA_TRIP_UPDATE_REQUEST_TOPIC=staging.yeodam.trip-update.request
KAFKA_TRIP_UPDATE_RESULT_TOPIC=staging.yeodam.trip-update.result
KAFKA_STORY_CREATE_REQUEST_TOPIC=staging.yeodam.story-create.request
KAFKA_STORY_CREATE_RESULT_TOPIC=staging.yeodam.story-create.result
IMAGE_SOURCE=s3
JOBS_FAKE_PIPELINE=false
# 실제 기능 연결 시 false로 바꾸고 async module:function을 지정한다.
JOBS_PROCESS_HANDLER=app.jobs.process_handler:run
JOBS_STORY_HANDLER=app.story.handler:run
JOBS_HEARTBEAT_SEC=5
JOBS_LEASE_SEC=120
JOBS_TIMEOUT_SEC=300
JOBS_PUBLISH_LEASE_SEC=60
JOBS_POLL_SEC=0.5
JOBS_PROCESS_STANDBY=2
EMBED_ON_PHOTOS_READY=true
JOBS_PHOTO_BATCH_TIMEOUT_SEC=60
JOBS_STORY_CONCURRENCY=4
JOBS_SHUTDOWN_GRACE_SEC=60
JOBS_PHOTOS_READY_TTL_SEC=604800

AI_APP_IMAGE=
QDRANT_DATA_DIR=
S3_BUCKET=
AWS_REGION=ap-northeast-2
S3_PRESIGN_EXPIRES_SEC=300
VLM_BASE_URL=
VLM_MODEL=
VLM_API_KEY=
VLM_TIMEOUT_SEC=60
VLM_CONNECT_TIMEOUT_SEC=5
RUNPOD_API_KEY=
RUNPOD_STATUS_CACHE_SEC=10
RUNPOD_STATUS_TIMEOUT_SEC=3
EMBED_MODEL=qwen3-vl-embedding-2b
VLLM_EMBEDDING_IMAGE=vllm/vllm-openai:v0.31.0
EMBEDDING_MODEL=Qwen/Qwen3-VL-Embedding-2B
EMBEDDING_MODEL_REVISION=9f2f7e710d6d81056aa5c0a4f04764fec6bb7bda
EMBEDDING_SERVED_MODEL_NAME=qwen3-vl-embedding-2b
EMBEDDING_API_KEY=
EMBEDDING_TIMEOUT_SEC=30
EMBEDDING_CONNECT_TIMEOUT_SEC=5
STORY_IMAGE_BUDGET=10
STORY_MAX_TOKENS=2048
STORY_BLUR_VAR_MIN=80
STORY_PHASH_MAX_DIST=4
STORY_DEDUPE_Z=1.0
GPU_GENERATION_INFLIGHT=8
GPU_SEARCH_EMBEDDING_INFLIGHT=2
GPU_WAIT_SEC=2
