# compose.yaml과 RunPod 템플릿 yeodam-vllm-gemma4(la07dfg9qc)에 같은 값 사용, 2026-10-15 A5000 실측 검증
VLLM_GENERATION_IMAGE=vllm/vllm-openai:v0.31.0
GENERATION_MODEL=cyankiwi/gemma-4-26B-A4B-it-AWQ-4bit
# 모델과 토크나이저 모두 이 revision으로 고정
GENERATION_MODEL_REVISION=180b2d35e35e4e48f6245367f3b41036f7cdabd6
# 클라이언트가 요청 본문의 model 필드에 넣는 이름, ai-api의 VLM_MODEL과 동일
GENERATION_SERVED_MODEL_NAME=gemma-4
# 실제 키는 저장소 밖에서 전달, RunPod는 Secret vllm_api_key
GENERATION_API_KEY=
# 모델 접근 권한이 필요할 때만, RunPod는 Secret hf_token
HF_TOKEN=

# 사진 10장 스토리 입력 약 3,600에서 4,300토큰과 출력 예산 포함, STORY_IMAGE_BUDGET 이상
GENERATION_MAX_IMAGES=10
GENERATION_MAX_MODEL_LEN=16384
# A5000 24GB에서 가중치 16.64 GiB, KV 캐시 3.85 GiB(43,116토큰)
GENERATION_GPU_MEMORY_UTILIZATION=0.90
GENERATION_MAX_NUM_SEQS=8
GENERATION_BIND_HOST=127.0.0.1
GENERATION_PORT=8004
