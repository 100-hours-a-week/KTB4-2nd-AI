# compose.yaml과 RunPod 실행 명령에 전달할 설정이다.
# Kael이 검증한 이미지 태그 또는 digest를 사용한다.
VLLM_GENERATION_IMAGE=
GENERATION_MODEL=
GENERATION_MODEL_REVISION=
GENERATION_SERVED_MODEL_NAME=
# 실제 키는 저장소 밖에서 전달한다.
GENERATION_API_KEY=
# 모델 접근 권한이 필요할 때만 설정한다.
HF_TOKEN=

# 실제 모델과 GPU에서 확인할 초기 예산. STORY_IMAGE_BUDGET 이상이어야 한다.
GENERATION_MAX_IMAGES=10
GENERATION_MAX_MODEL_LEN=16384
GENERATION_BIND_HOST=127.0.0.1
GENERATION_PORT=8004
