# compose.yaml과 RunPod 템플릿 yeodam-vllm-gemma4(la07dfg9qc)에 같은 값 사용, 2026-10-28 A40 실측 검증
VLLM_GENERATION_IMAGE=vllm/vllm-openai:v0.31.0
GENERATION_MODEL=google/gemma-4-31B-it-qat-w4a16-ct
# 모델과 토크나이저 모두 이 revision으로 고정
GENERATION_MODEL_REVISION=52f3f65bc7a02d555763bc923bd1d9094898219d
# 클라이언트가 요청 본문의 model 필드에 넣는 이름, ai-api의 VLM_MODEL과 동일
GENERATION_SERVED_MODEL_NAME=gemma-4
# 실제 키는 저장소 밖에서 전달, RunPod는 Secret vllm_api_key
GENERATION_API_KEY=
# 모델 접근 권한이 필요할 때만, RunPod는 Secret hf_token
HF_TOKEN=

# 미분류 사진 재배치 작업의 요청당 사진 30장 입력 약 12,000토큰과 여러 턴 대화, 출력 예산 포함, STORY_IMAGE_BUDGET 이상
GENERATION_MAX_IMAGES=30
GENERATION_MAX_MODEL_LEN=32768
# A40 48GB에서 가중치 19.78 GiB, KV 캐시 19.3 GiB(89,055토큰)
GENERATION_GPU_MEMORY_UTILIZATION=0.90
GENERATION_MAX_NUM_SEQS=8
GENERATION_BIND_HOST=127.0.0.1
GENERATION_PORT=8004
